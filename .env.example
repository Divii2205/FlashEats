# Warehouse (Postgres in Docker)
PGHOST=localhost
PGPORT=5432
PGUSER=flasheats
PGPASSWORD=flasheats
PGDATABASE=flasheats_wh

# Source systems
SQLITE_PATH=sources/database/flasheats.db
FILES_DIR=sources/data
DISPATCH_API_URL=http://localhost:8000

# Retrieval behaviour
API_PAGE_SIZE=50
API_MAX_RETRIES=4
API_BACKOFF_BASE_SECONDS=0.5

# Validation policy
FRESHNESS_MAX_AGE_DAYS=30
MATERIAL_LATE_THRESHOLD_MIN=10
